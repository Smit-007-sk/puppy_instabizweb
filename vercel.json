{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/image.js": {
      "includeFiles": "{brand,media,puppies}/**"
    }
  },
  "rewrites": [
    {
      "source": "/_next/image",
      "destination": "/api/image"
    },
    {
      "source": "/puppies/:slug",
      "destination": "/puppies/:slug.html"
    }
  ]
}
